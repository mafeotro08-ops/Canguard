DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Clave secreta para firmar las cookies de sesión (cámbiala en producción)
SECRET_KEY=
# Tiempo de vida de sesión en segundos (3600 = 1 hora)
SESSION_LIFETIME=

# Correo (recuperación de contraseña). Mientras SMTP_HOST esté comentado,
# los correos NO se envían: el enlace se imprime en la consola de uvicorn.
# Ejemplo con Gmail (requiere una "contraseña de aplicación", no la normal):
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Dirección de la app que va en los enlaces de los correos.
# En local es 127.0.0.1; al publicar la app, cámbiala por el dominio real
# (por ejemplo https://canguardk9.com) y los correos usarán ese enlace.
APP_URL=

# Groq — transcripción de audio/video (plan gratuito: https://console.groq.com/keys)
GROQ_API_KEY=

# Días que se guardan los videos/audios antes de borrarlos para ahorrar espacio
# (la transcripción y el documento Word se conservan). Lo usa limpiar_videos.py.
VIDEO_RETENCION_DIAS=30
